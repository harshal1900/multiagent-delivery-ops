# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# OpenAI-compatible chat completions endpoint.
OPENAI_API_KEY=sk-...
# Leave unset to use api.openai.com, or point at a gateway/proxy:
# OPENAI_API_BASE=https://your-gateway.example.com/openai/v1

GEN_MODEL=gpt-4o
EVAL_MODEL=gpt-4o

# Optional: point at a different copy of the dataset. Defaults to the
# sample dataset shipped in data/sample/.
# DATA_DIR=/path/to/your/data

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multiagent-delivery-ops
